APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=tinh_shop

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps server key — used by the backend to reverse
# geocode the pin dropped in the address picker.
GOOGLE_MAPS_SERVER_KEY=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Firebase Cloud Messaging — service account used for the push notifications.
FIREBASE_CREDENTIALS=firebase/service-account.json.json

# Firebase Authentication — phone OTP password recovery.
# The project id must match the Firebase project used by the Flutter app
# (see frontend/lib/firebase_options.dart) and the audiences are the
# Firebase app ids allowed to issue ID tokens for that project.
FIREBASE_PROJECT_ID=tinh-shop
FIREBASE_ALLOWED_AUDIENCES=
# A phone-authentication session older than this (seconds) is rejected.
FIREBASE_PHONE_AUTH_MAX_AGE=600
# Country code used to normalise locally formatted phone numbers.
FIREBASE_DEFAULT_COUNTRY_CODE=855

# Bakong Open API (KHQR payments) — https://api-bakong.nbc.gov.kh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
# Bakong account that receives the money, e.g. tinhshop@aclb
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME="TINH SHOP"
BAKONG_MERCHANT_CITY="PHNOM PENH"
BAKONG_CURRENCY=USD
# Exchange rate for paying in Riel: 1 USD = X KHR (keep in sync with NBC).
BAKONG_USD_KHR_RATE=4100
BAKONG_QR_EXPIRY_MINUTES=15


VITE_APP_NAME="${APP_NAME}"
